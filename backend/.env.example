APP_NAME=Aspire Internal Brain
ENVIRONMENT=dev

DATABASE_URL=postgresql+psycopg2://rbac:rbac@postgres:5432/rbac_rag
REDIS_URL=redis://redis:6379/0

JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

VECTOR_BACKEND=qdrant
QDRANT_URL=http://qdrant:6333

LLM_BACKEND=openai_compat
EMBEDDING_BACKEND=local
OCR_BACKEND=tesseract

# IdP / SSO provider: mock (default) | oidc (future) | saml (future)
IDP_PROVIDER=mock
# Optional: path to a JSON file mapping IdP group names to local role_ids
# Leave empty to use built-in defaults
IDP_GROUP_ROLE_MAP_PATH=

# Tencent Cloud (fill in to switch backends to tencent_vectordb / hunyuan / tencent OCR)
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# Embedding model: Qwen/Qwen3-Embedding-0.6B (1024-dim, ~1.2GB, needs ~3GB RAM) or
# BAAI/bge-base-zh-v1.5 (768-dim, ~500MB).
# The four thresholds below are calibrated for Qwen3-Embedding-0.6B. If you change
# the model you MUST (1) set EMBEDDING_DIM to match, (2) re-run seed_vectorstore.py
# (the collection is rebuilt), and (3) re-calibrate the thresholds with
# `python -m eval.run_retrieval_eval` -- otherwise restricted questions may be
# answered instead of denied.
LOCAL_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIM=1024
# Peak-RAM knobs for the local embedder (OOM on 8GB hosts without these): smaller batch = less memory.
EMBEDDING_BATCH_SIZE=4
EMBEDDING_MAX_SEQ_LENGTH=1024
RELEVANCE_THRESHOLD=0.42
DENY_MARGIN=0.15
DENY_STRONG_SCORE=0.58

# LLM via Tencent TokenHub (OpenAI-compatible). Backends: openai_compat | hunyuan | deepseek | mock
# hy3 via TokenHub: LLM_BASE_URL=https://tokenhub.tencentmaas.com/v1, LLM_MODEL=hy3
# local Ollama (qwen2.5:7b) via the host: LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_BASE_URL=https://tokenhub.tencentmaas.com/v1
LLM_MODEL=hy3
LLM_API_KEY=

# Claude (Anthropic API) for answer generation
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_EFFORT=low
SERVE_FLOOR=0.40
