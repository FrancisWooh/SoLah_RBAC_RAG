APP_NAME=Aspire Internal Brain
ENVIRONMENT=dev

DATABASE_URL=postgresql+psycopg2://rbac:rbac@postgres:5432/rbac_rag
REDIS_URL=redis://redis:6379/0

JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

VECTOR_BACKEND=qdrant
QDRANT_URL=http://qdrant:6333

LLM_BACKEND=anthropic
EMBEDDING_BACKEND=local
OCR_BACKEND=tesseract

# IdP / SSO provider: mock (default) | oidc (future) | saml (future)
IDP_PROVIDER=mock
# Optional: path to a JSON file mapping IdP group names to local role_ids
# Leave empty to use built-in defaults
IDP_GROUP_ROLE_MAP_PATH=

# Tencent Cloud (fill in to switch backends to tencent_vectordb / hunyuan / tencent OCR)
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# similarity cut-offs, calibrated for Qwen3-Embedding-0.6B + structured chunks (offtopic <= 0.37; see eval/results)
RELEVANCE_THRESHOLD=0.42
DENY_MARGIN=0.15
DENY_STRONG_SCORE=0.58

# LLM via Tencent TokenHub (OpenAI-compatible). Backends: openai_compat | hunyuan | deepseek | mock
# local Ollama (qwen2.5:7b) via the host; for TokenHub use https://tokenhub-intl.tencentcloudmaas.com/v1
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=ollama

# Claude (Anthropic API) for answer generation
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_EFFORT=low
SERVE_FLOOR=0.40
