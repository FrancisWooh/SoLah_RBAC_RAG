# =============================================================================
# .env.prod — Production environment variables for docker-compose.prod.yml
# Copy to .env.prod, fill in real values, then:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
# =============================================================================

# --- Public access ---
# The public URL users will visit (for frontend API base URL and redirects)
PUBLIC_URL=https://aspire.5gbulab.tech

# --- PostgreSQL ---
POSTGRES_USER=rbac
POSTGRES_PASSWORD=CHANGE_ME_to_a_strong_password
POSTGRES_DB=rbac_rag

# --- Frontend ---
# Frontend env file (copy frontend/.env.example, set this)
# VITE_API_BASE_URL will be set to PUBLIC_URL automatically in compose

# --- Backend secrets (in backend/.env, not here) ---
# Make sure backend/.env has:
#   JWT_SECRET=<random strong secret>
#   LLM_API_KEY=<your TokenHub API key>
#   LLM_BASE_URL=https://tokenhub.tencentmaas.com/v1
#   LLM_MODEL=hy3
#   LLM_BACKEND=openai_compat
